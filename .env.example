# Postgres connection string (Neon, Supabase, or any Postgres).
# Neon:     postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# Leave empty in local development and the app falls back to an in-memory store
# (data lost on restart). Production refuses to start without it.
DATABASE_URL=

# Key for /admin, where the wording of the twelve items is edited.
# Unset in production means there is no admin screen at all (404).
# Unset in development falls back to "dev".
ADMIN_KEY=
